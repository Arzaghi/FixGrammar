{
  "manifest_version": 3,
  "name": "FixGrammar",
  "version": "1.0.0",
  "description": "Fix grammar and translate/rewrite text in any tone using Google Gemini.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FixGrammar"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}